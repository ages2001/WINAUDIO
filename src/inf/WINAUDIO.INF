%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_6E50
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&CC_0480
%SST.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_22A8
%SST.Desc%=WINAUDIO.Bus,ACPI\80860F28
%SST.Desc%=WINAUDIO.Bus,ACPI\808622A8
%SST.Desc%=WINAUDIO.Bus,ACPI\INT3438

[WINAUDIO.Bus]
CopyFiles=WINAUDIO.Copy,WINAUDIO.Firmware,WINAUDIO.CopyInf
AddReg=WINAUDIO.AddReg
UpdateInis=WINAUDIO.Inis

[WINAUDIO.AddReg]
HKR,,DevLoader,,WINAUDIO.VXD
HKR,,Options,,""
HKR,,DriverDesc,,"%Provider% WINAUDIO 1.1"

; WIN4G.VXD moves PCI resources above 4G below 4G before the PCI bus is enumerated
[WINAUDIO.Inis]
system.ini,386Enh,,"device=win4g.vxd"

[WINAUDIO.Copy]
WINAUDIO.VXD
WIN4G.VXD
WINSOUND.DRV
WINMIX.EXE
AUDTEST.EXE

[WINAUDIO.CopyInf]
WINAUDM.INF

