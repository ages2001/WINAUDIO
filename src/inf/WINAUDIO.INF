; WINAUDIO.INF - WINDRV 1.1 WINAUDIO for Windows 95, 98 and ME: System devices
; High Definition Audio controllers and Intel audio DSPs (SST / SOF firmware in WINDRVFW) are
; buses: WINAUDIO.VXD drives them and gives every codec and DSP device a child devnode of its
; own (Sound, video and game controllers, WINAUDM.INF), named after the chip. AC'97
; controllers are sound devices themselves (WINAUDM.INF).

[Version]
Signature="$CHICAGO$"
Class=System
Provider=%Provider%

[DestinationDirs]
DefaultDestDir=11
WINAUDIO.Firmware=11,WINDRVFW
WINAUDIO.CopyInf=17

[SourceDisksNames]
1=%DiskName%,,0

[SourceDisksFiles]
WINAUDIO.VXD=1
WIN4G.VXD=1
WINSOUND.DRV=1
WINMIX.EXE=1
AUDTEST.EXE=1
WINAUDM.INF=1
CS42L43.BIN=1,WINDRVFW
DSPSKL.BIN=1,WINDRVFW
FIRMWARE.TXT=1,WINDRVFW
LICCIRR.TXT=1,WINDRVFW
LICSOF.TXT=1,WINDRVFW
LICSST.TXT=1,WINDRVFW
S4ADL.RI=1,WINDRVFW
S4ADLN.RI=1,WINDRVFW
S4ADLS.RI=1,WINDRVFW
S4ARLS.RI=1,WINDRVFW
S4LNL.RI=1,WINDRVFW
S4LNLC.RI=1,WINDRVFW
S4MTL.RI=1,WINDRVFW
S4MTLC.RI=1,WINDRVFW
S4NVL.RI=1,WINDRVFW
S4NVLC.RI=1,WINDRVFW
S4NVLS.RI=1,WINDRVFW
S4NVLSC.RI=1,WINDRVFW
S4PTL.RI=1,WINDRVFW
S4PTLC.RI=1,WINDRVFW
S4TGL.RI=1,WINDRVFW
S4TGLC.RI=1,WINDRVFW
S4TGLH.RI=1,WINDRVFW
S4TGLHC.RI=1,WINDRVFW
S4WCL.RI=1,WINDRVFW
S4WCLC.RI=1,WINDRVFW
SOFAPL.RI=1,WINDRVFW
SOFAPLC.RI=1,WINDRVFW
SOFBDW.RI=1,WINDRVFW
SOFBYT.RI=1,WINDRVFW
SOFCHT.RI=1,WINDRVFW
SOFCNL.RI=1,WINDRVFW
SOFCNLC.RI=1,WINDRVFW
SOFEHL.RI=1,WINDRVFW
SOFEHLC.RI=1,WINDRVFW
SOFICL.RI=1,WINDRVFW
SOFICLC.RI=1,WINDRVFW
SOFJSL.RI=1,WINDRVFW
SOFJSLC.RI=1,WINDRVFW
[Manufacturer]
%Provider%=WINDRV

; Windows 95 matches only the 4-digit class code (PCI\CC_0403): WINAUDIO.VXD writes the name
; with the maker of the chip set when it starts the controller. Intel DSPs of the 300 series
; and later report class 04/01 like AC'97: their device ids pick this file.
[WINDRV]
%HDA.Desc%=WINAUDIO.Bus,PCI\CC_040300
%HDA.Desc%=WINAUDIO.Bus,PCI\CC_0403
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_9D70
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_A170
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_9D71
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_A171
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_A2F0
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_5A98
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_1A98
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_3198
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_9DC8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_A348
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_02C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_06C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_A3F0
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_F1C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_34C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_3DC8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_38C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_4DC8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_4B55
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_4B58
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_A0C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_43C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_F0C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51C9
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51CC
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51CD
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51CA
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51CB
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51CE
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_51CF
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_7AD0
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_7A50
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_54C8
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_7E28
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_7728
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_7F50
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_A828
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_E428
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_E328
%DSP.Desc%=WINAUDIO.Bus,PCI\VEN_8086&DEV_4D28
