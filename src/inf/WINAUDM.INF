; WINAUDM.INF - WINDRV 1.2 WINAUDIO for Windows 95, 98 and ME: Sound, video and game controllers
; AC'97 controllers, and the codecs and DSP devices on the buses of WINAUDIO.INF. MMDEVLDR.VXD
; is the DevLoader and WINAUDIO.VXD its driver; MMSYSTEM loads WINSOUND.DRV (wave, MIDI, mixer,
; aux) for every such devnode, so DirectSound finds the DirectSound driver of WINAUDIO.VXD for
; the wave device. SYSTRAY is the volume icon of the taskbar, WINMIX a volume control of its own.

[Version]
Signature="$CHICAGO$"
Class=MEDIA
Provider=%Provider%

[DestinationDirs]
DefaultDestDir=11

[SourceDisksNames]
1=%DiskName%,,0

[SourceDisksFiles]
WINAUDIO.VXD=1
WIN4G.VXD=1
WINSOUND.DRV=1
WINMIX.EXE=1
AUDTEST.EXE=1

[Manufacturer]
%Provider%=WINDRV

[WINDRV]
%AC97.Desc%=WINAUDM.AC97,PCI\CC_040100
%AC97.Desc%=WINAUDM.AC97,PCI\CC_0401
%Codec.Desc%=WINAUDM.Func,WINAUDIO\HDA_AUDIO
%HDMI.Desc%=WINAUDM.Func,WINAUDIO\HDA_HDMI
%Modem.Desc%=WINAUDM.Func,WINAUDIO\HDA_MODEM
%Other.Desc%=WINAUDM.Func,WINAUDIO\HDA_OTHER
%DMIC.Desc%=WINAUDM.Func,WINAUDIO\DSP_DMIC
%I2S.Desc%=WINAUDM.Func,WINAUDIO\DSP_I2S
%SDW.Desc%=WINAUDM.Func,WINAUDIO\DSP_SDW
%DSPHDA.Desc%=WINAUDM.Func,WINAUDIO\DSP_HDA

; ---- AC'97: the controller is the sound device ----
[WINAUDM.AC97]
CopyFiles=WINAUDM.Copy
AddReg=WINAUDM.Media.AddReg,WINAUDM.AC97.AddReg
UpdateInis=WINAUDM.Inis4G

[WINAUDM.AC97.AddReg]
HKR,,Options,,""
HKR,,DriverDesc,,"%Provider% WINAUDIO 1.2"

; ---- codecs and DSP devices on the buses of WINAUDIO.VXD ----
[WINAUDM.Func]
CopyFiles=WINAUDM.Copy
AddReg=WINAUDM.Media.AddReg

; MMDEVLDR.VXD loads WINAUDIO.VXD for the devnode, MMSYSTEM the multimedia drivers listed here
[WINAUDM.Media.AddReg]
HKR,,DevLoader,,mmdevldr.vxd
HKR,,Driver,,WINAUDIO.VXD
HKR,Drivers,MIGRATED,,0
HKR,Drivers,SubClasses,,"wave,midi,mixer,aux"
HKR,Drivers\wave\winsound.drv,Driver,,winsound.drv
HKR,Drivers\wave\winsound.drv,Description,,%Wave.Desc%
HKR,Drivers\midi\winsound.drv,Driver,,winsound.drv
HKR,Drivers\midi\winsound.drv,Description,,%Midi.Desc%
HKR,Drivers\mixer\winsound.drv,Driver,,winsound.drv
HKR,Drivers\mixer\winsound.drv,Description,,%Mixer.Desc%
HKR,Drivers\aux\winsound.drv,Driver,,winsound.drv
HKR,Drivers\aux\winsound.drv,Description,,%Aux.Desc%
HKLM,Software\Microsoft\Windows\CurrentVersion\Run,SystemTray,,"SysTray.Exe"

[WINAUDM.Inis4G]
system.ini,386Enh,,"device=win4g.vxd"

[WINAUDM.Copy]
WINAUDIO.VXD
WIN4G.VXD
WINSOUND.DRV
WINMIX.EXE
AUDTEST.EXE

[Strings]
Provider="WINDRV"
DiskName="WINDRV WINAUDIO 1.2 disk"
AC97.Desc="WINAUDIO AC'97 Audio Controller"
Codec.Desc="WINAUDIO High Definition Audio Codec"
HDMI.Desc="WINAUDIO HDMI / DisplayPort Audio Codec"
Modem.Desc="WINAUDIO HD Audio Modem Codec"
Other.Desc="WINAUDIO HD Audio Function"
DMIC.Desc="WINAUDIO Intel DSP Digital Microphones"
I2S.Desc="WINAUDIO Intel DSP I2S Audio Codec"
SDW.Desc="WINAUDIO Intel DSP SoundWire Audio Codec"
DSPHDA.Desc="WINAUDIO Intel DSP HD Audio Codec"
Wave.Desc="WINAUDIO wave"
Midi.Desc="WINAUDIO GM Synth"
Mixer.Desc="WINAUDIO mixer"
Aux.Desc="WINAUDIO volume"
